{
  "name": "expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "i18next": "^26.4.2",
    "libphonenumber-js": "^1.13.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@swmansion/argent": "^0.25.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:sim": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p ios --profile development-simulator",
    "build:dev:ios": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p ios --profile development",
    "build:dev:android": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p android --profile development",
    "build:preview:ios": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p ios --profile preview",
    "build:preview:android": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p android --profile preview",
    "build:prod:ios": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p ios --profile production",
    "build:prod:android": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=$PWD/build eas build --local -p android --profile production",
    "release:cloud": "eas build -p all --profile production",
    "release:submit": "eas submit -p all --profile production --latest",
    "update:preview": "APP_VARIANT=preview EXPO_PUBLIC_API_MOCK=false eas update --channel preview --environment preview",
    "update:prod": "APP_VARIANT=production EXPO_PUBLIC_API_MOCK=false eas update --channel production --environment production",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "doctor": "npx expo-doctor",
    "rename": "node scripts/rename.mjs",
    "eas:init": "node scripts/eas-init.mjs",
    "prepare": "lefthook install"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-google-signin|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|uniwind|@tanstack/.*|zustand|i18next|react-i18next))"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "unrs-resolver"
    ]
  }
}
