# Everything prefixed EXPO_PUBLIC_ is inlined into the JS bundle — never put secrets here.

# Your backend. Leave API_MOCK=true to run the app end-to-end without a backend.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_MOCK=true

# Comma-separated: phone, google, apple, email, email_otp, magic_link
EXPO_PUBLIC_AUTH_PROVIDERS=phone,google,apple,email,email_otp,magic_link

# Google Sign-In (https://react-native-google-signin.github.io/docs/setting-up/get-config-file)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
